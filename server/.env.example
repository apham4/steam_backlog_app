# Database
DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

# Steam API
STEAM_GET_OWNED_GAMES_URL=https://api.steampowered.com/IPlayerService/GetOwnedGames/v0001/
STEAM_FETCH_APP_DETAILS_URL=https://store.steampowered.com/api/appdetails/
STEAM_FETCH_APP_REVIEWS_URL=https://store.steampowered.com/appreviews/{app_id}
STEAM_API_KEY=YOUR_STEAM_API_KEY
STEAM_API_TIMEOUT_SECONDS=10
DEV_STEAM_ID=YOUR_TEST_STEAM_ID
DEV_USERNAME=YOUR_TEST_USERNAME

# FastAPI App
APP_NAME=SERVER_APP_NAME
CORS_ORIGINS=[LIST_OF_ALLOWED_ORIGINS]
CORS_METHODS=[LIST_OF_ALLOWED_METHODS]
CORS_HEADERS=[LIST_OF_ALLOWED_HEADERS]

# Default Rules
GAME_CACHE_TTL_DAYS=7
BACKLOG_THRESHOLD_MINS=60
RECENT_THRESHOLD_MINS=120
SKIP_COOLDOWN_DAYS=3